VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only piano studio connection. Never prefix these with VITE_.
PIANO_STUDIO_SUPABASE_URL=
PIANO_STUDIO_SERVICE_KEY=
# The verified Elephant auth user ID allowed to read the studio schedule.
PIANO_STUDIO_OWNER_ID=
# SHA-256 of the private local calendar key. The key itself is shared only via a private fragment link.
PIANO_STUDIO_LOCAL_KEY_HASH=

# Private desktop workspace storage in the VITE_SUPABASE_URL project's elephant schema.
# Never put a service key or management token in a VITE_ variable.
ELEPHANT_SUPABASE_SERVICE_KEY=
ELEPHANT_WORKSPACE_KEY_HASH=
ELEPHANT_WORKSPACE_ID=desktop
